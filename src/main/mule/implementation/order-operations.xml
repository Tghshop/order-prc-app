	<sub-flow name="post-order-record-sub-flow" doc:id="7caa2e9e-08ac-41cf-b3eb-e563f3497018">
		<json-logger:logger doc:name="log-post-order-record-sub-flow-start" doc:id="919e78be-03d0-4542-9477-97154408e8e9" config-ref="json-logger-config" message='#["----------------" ++ upper("log-post-order-record-sub-flow-start") ++ "-----------------"]'>
			<json-logger:content ><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
		<ee:transform doc:name="req-variable-payload-prep" doc:id="9b052d77-a947-4fc4-b250-48268a3805f3">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
var ord = vars.requestParams.payload
---
[
	{
		"Inventory__c": ord.inventory default "",
    	"Order_Status__c": "Placed",
    	"Total_Price__c": ord.totalPrice default "",
    	"Order_Date__c": (now() as String { format: "yyyy-MM-dd" }),
    	"DeliveryPartner__c": ord.deliveryPartner default "",
    	"Customer__c": ord.custId default "",
    	"Quantity__c": ord.quantity default "",
    	"Invoice__c": ord.invoice default "",
    	"Order_Id__c": ord.orderId default "",
    	"Delivery_Address__c": ord.deliveryAddress default "",
    	"Warehouse_city__c": ord.warehouseCity default ""
	}
]
]]></ee:set-payload>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="req" ><![CDATA[%dw 2.0
output application/json
---
{
	"method": "POST",
	"path": "/orders"
}]]></ee:set-variable>

			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="sys-api-call-impl-sub-flow" doc:id="c7919eaa-10c0-49a2-b3f3-8fb8744a9e45" name="sf-sys-api-call-impl-sub-flow" target="ordResponse"/>
		<choice doc:name="Choice" doc:id="1255f783-4a32-43f5-8604-2111a2b0ddd4" >
			<when expression="#[vars.ordResponse.successful]">
				<ee:transform doc:name="customer-req-varaible" doc:id="2ba2b020-e3ba-43cd-85ae-215346a1f36c">
			<ee:message>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="req"><![CDATA[%dw 2.0
output application/json
---
{
	"method": "GET",
	"path": "/customers/" ++ vars.requestParams.payload.custId as String
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
				<flow-ref doc:name="sf-sys-api-call-impl-sub-flow" doc:id="0628436e-9d21-46f2-bfd6-63c78404e00d" name="sf-sys-api-call-impl-sub-flow" target="customer" />
				<ee:transform doc:name="Email-payload" doc:id="315daa84-8d0f-465e-9fac-356a33562efd">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
---
{
	email: vars.customer[0].Email__c,
	subject: "Your Order Has Been Successfully Created – TGHShop",
	body: "Hello " ++ vars.customer[0].Name__c as String ++ "\n" ++ 
	"Thank you for shopping with TGHShop.\n" ++ 
	"Your order has been successfully created in our system."
}]]></ee:set-payload>
			</ee:message>
					<ee:variables >
						<ee:set-variable variableName="req" ><![CDATA[%dw 2.0
output application/json
---
{
}]]></ee:set-variable>
					</ee:variables>
		</ee:transform>
				<flow-ref doc:name="mail-sys-call-impl-sub-flow" doc:id="6d8f7128-89a3-4bf3-b7e5-d2c39e6f34d6" name="mail-sys-call-impl-sub-flow" />
				<flow-ref doc:name="invoice-creation-sub-flow" doc:id="cbe6a1e4-31ba-4645-88be-e29fc57b7bd9" name="invoice-creation-sub-flow" />
				<ee:transform doc:name="response-payload" doc:id="bd57748b-43f2-4ce1-80d4-5454b5447035" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
  message: "Order record created successfully",
  orderId: vars.requestParams.payload.orderId,
  createdAt: now()
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</when>
			<otherwise>
				<ee:transform doc:name="response-payload" doc:id="5d5599a7-21af-46c6-8323-ad416369e7af" >
					<ee:message >
						<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
{
	"message": vars.ordResponse.items[0].message
}]]></ee:set-payload>
					</ee:message>
				</ee:transform>
			</otherwise>
		</choice>
		<json-logger:logger doc:name="log-post-order-record-sub-flow-end" doc:id="6ca083e3-2ec9-4f78-9b6d-fb5ef93870f5" config-ref="json-logger-config" message='#["----------------" ++ upper("post-order-record-sub-flow-end") ++ "-----------------"]' >
			<json-logger:content ><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
	
</sub-flow>
	<sub-flow name="patch-order-details-sub-flow" doc:id="dd3ed35f-59fc-4093-8760-0cd6dbbf47d7">
		<json-logger:logger doc:name="log-patch-order-details-sub-flow-start" doc:id="3d97e9a9-5815-4138-8d47-bc28193edf64" config-ref="json-logger-config" message='#["-------------" ++ upper("log-patch-order-details-sub-flow-start") ++ "---------------"]'>
			<json-logger:content ><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
		<flow-ref doc:name="get-order-byid-sub-flow" doc:id="db5dfe82-88bb-40c9-b16c-0316d84d394a" name="get-order-byid-sub-flow" target="order"/>
		<ee:transform doc:name="req-vaiable-payload-prep" doc:id="3a6b006f-8954-47e5-908c-fa69a878976c">
			<ee:message>
				<ee:set-payload><![CDATA[%dw 2.0
output application/json
var updDet = vars.requestParams.payload
var sf = {
	"Inventory__c": updDet.inventory default "",
   	"Order_Status__c": updDet.orderStatus default "",
   	"Total_Price__c": updDet.totalPrice default "",
   	"DeliveryPartner__c": updDet.deliveryPartner default "",
   	"Customer__c": updDet.custId default "",
    "Quantity__c": updDet.quantity default "",
   	"Invoice__c": updDet.invoice default "",
   	"Order_Id__c": updDet.orderId default "",
   	"Delivery_Address__c": updDet.deliveryAddress default ""
} filterObject ((value, key, index) -> value != "")
---
[(vars.order[0] -- (sf pluck ((value, key, index) ->key)) ++ sf)]
]]></ee:set-payload>
			</ee:message>
			<ee:variables>
				<ee:set-variable variableName="req" ><![CDATA[%dw 2.0
output application/json
---
{
	"method": "PATCH",
	"path": "/orders/" ++ vars.requestParams.uriParams.orderId as String default ""
}]]></ee:set-variable>

			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="sys-api-call-impl-sub-flow" doc:id="eb796e36-0555-4ef6-949c-179ba7eee361" name="sf-sys-api-call-impl-sub-flow"/>
		<json-logger:logger doc:name="log-patch-order-details-sub-flow-end" doc:id="00f3b529-9ce5-443a-bdda-b358352d67c3" config-ref="json-logger-config" message='#["-------------" ++ upper("log-patch-order-details-sub-flow-end") ++ "---------------"]' >
			<json-logger:content ><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
	
</sub-flow>
	<sub-flow name="delete-order-sub-flow" doc:id="3ec46247-7115-46bb-b336-ecdf0c143aaa" >
		<json-logger:logger doc:name="log-delete-order-sub-flow-start" doc:id="70c124d4-27fc-4571-9cce-04c04531f2ad" config-ref="json-logger-config" message='#["-------------" ++ upper("log-delete-order-sub-flow-start") ++ "---------------"]' >
			<json-logger:content ><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
		<flow-ref doc:name="get-order-byid-sub-flow" doc:id="f286db53-6f1f-45b3-aa78-4958399e6f5e" name="get-order-byid-sub-flow" target="order" />
		<ee:transform doc:name="req-variable-payload-prep" doc:id="8ebef353-697b-4695-9424-d0b4af66a629" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
(vars.order[0] - "IsCancelled__c") ++ {
	"IsCancelled__c": true
}]]></ee:set-payload>
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="req" ><![CDATA[%dw 2.0
output application/json
---
{
	"method": "DELETE",
	"path": "/orders/" ++ vars.requestParams.uriParams.orderId as String default ""
}]]></ee:set-variable>

			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="sys-api-call-impl-sub-flow" doc:id="04858392-e653-47a6-9a22-7c1955f69081" name="sf-sys-api-call-impl-sub-flow" />
		<json-logger:logger doc:name="log-delete-order-sub-flow-end" doc:id="2c3448bd-6524-4038-89d4-ee7ae0b8fb2e" config-ref="json-logger-config" message='#["-------------" ++ upper("log-delete-order-sub-flow-end") ++ "---------------"]' >
			<json-logger:content ><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
	
</sub-flow>
	<sub-flow name="invoice-creation-sub-flow" doc:id="7aea65d7-609d-476e-be83-24e12d05b74d" >
		<json-logger:logger doc:name="log-invoice-creation-sub-flow-start" doc:id="9e39b65f-6e66-4851-9663-c7a721629fe0" config-ref="json-logger-config" message='#["-------------" ++ upper("log-invoice-creation-sub-flow-start") ++ "---------------"]' >
			<json-logger:content ><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
		<ee:transform doc:name="req-variable-payload-prep" doc:id="9c8b088c-f065-4880-8b67-8e7d70ba1910" >
			<ee:message >
				<ee:set-payload ><![CDATA[%dw 2.0
output application/json
---
[{
  "Order__c": vars.ordResponse.items[0].id,
  "Customer__c": vars.customer[0].Id,
  "Invoice_Date__c": now() as String{foramt: "yyyy-MM-dd"},
  "Tax__c": 180,
  "Discount__c": 30,
  "Total_Price__c": vars.requestParams.payload.totalPrice
}]]]></ee:set-payload>
			</ee:message>
			<ee:variables >
				<ee:set-variable variableName="req" ><![CDATA[%dw 2.0
output application/json
---
{
	"method": "POST",
	"path": "/invoices"
}]]></ee:set-variable>
			</ee:variables>
		</ee:transform>
		<flow-ref doc:name="sf-sys-api-call-impl-sub-flow" doc:id="8fb8649f-4b80-40d2-a179-0e50094f9901" name="sf-sys-api-call-impl-sub-flow"/>
		<json-logger:logger doc:name="log-invoice-creation-sub-flow-end" doc:id="39828095-2c02-4415-a373-163b9aa24289" config-ref="json-logger-config" message='#["-------------" ++ upper("log-invoice-creation-sub-flow-end") ++ "---------------"]' >
			<json-logger:content ><![CDATA[#[payload]]]></json-logger:content>
		</json-logger:logger>
	</sub-flow>
</mule>
