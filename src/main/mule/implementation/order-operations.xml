			<ee:variables>
				<ee:set-variable variableName="req" ><![CDATA[%dw 2.0
output application/json
---
{
	"method": "GET",
	"path": "/orders/" ++ vars.requestParams.uriParams.orderId as String default ""
}]]></ee:set-variable>

